# CLIENT
NEXT_PUBLIC_API_URL="http://localhost:3333"

# SERVER
DATABASE_URL="postgres://docker:docker@localhost:5432/servifast?schema=public"

JWT_SECRET=your-jwt-secret

# Web app URL, used to build links (e.g. invite links) inside e-mails
WEB_URL="http://localhost:3000"

# Get an API key at https://resend.com — leave unset to disable e-mail sending
RESEND_API_KEY=your-resend-api-key
# Use Resend's shared test sender until you verify your own domain
RESEND_FROM_EMAIL="onboarding@resend.dev"
